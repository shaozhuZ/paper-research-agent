# Copy to .env and fill in. docker compose reads this file.
GOOGLE_API_KEY=
GEMINI_EMB_MODEL=gemini-embedding-001

# Chat model for the agent, as provider:model (google or openai)
LLM_MODEL=openai:gpt-6-luna
# LLM_MODEL=google:gemini-3-flash-preview
OPENAI_API_KEY=
# low | medium | high; empty = provider default
LLM_REASONING_EFFORT=
# loop = model-driven tool loop; fast = one search in code + one model call
AGENT_MODE=fast

# Retrieval (mcp-server): dense | bm25 | hybrid, optional cross-encoder rerank via Voyage
RETRIEVAL_MODE=dense
RETRIEVAL_RERANK=true
VOYAGE_API_KEY=
RERANK_MODEL=rerank-3

# Eval scripts (question generation, LLM judge)
DEEPSEEK_API_KEY=
EVAL_MODEL=deepseek:deepseek-chat

# Optional
SEMANTIC_SCHOLAR_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGSMITH_TRACING=false
LOG_LEVEL=INFO
