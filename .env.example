# Copy to .env and fill in. docker compose reads this file.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMB_MODEL=gemini-embedding-001

# Eval scripts (question generation, LLM judge)
DEEPSEEK_API_KEY=
EVAL_MODEL=deepseek:deepseek-chat

# Optional
SEMANTIC_SCHOLAR_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGSMITH_TRACING=false
LOG_LEVEL=INFO
